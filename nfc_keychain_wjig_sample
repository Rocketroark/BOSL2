// Safely clamping the bevel per tag so it never breaks the rendering of very thin keychains
function safe_bevel(p) = min(bevel_radius, (p[33] / 2) - 0.01);

// Generating the exact core thickness needed to hit the absolute target thickness
function core_thick(p) = max(0.01, p[33] - (safe_bevel(p) * 2));

function degcos(a) = cos(a);
function degsin(a) = sin(a);

function get_w(p) = 
    p[1] == "oval" ? max(p[3], p[4]) :
    p[1] == "square" || p[1] == "rectangle" || p[1] == "custom_svg" ? p[3] : p[3];

function get_h(p) = 
    p[1] == "oval" ? (15 + p[4]/2 + p[3]/2) : 
    p[1] == "square" || p[1] == "rectangle" || p[1] == "custom_svg" ? p[4] : p[3];

function body_half_width(p) = (get_w(p) / 2) + safe_bevel(p);
function body_half_height(p) = (get_h(p) / 2) + safe_bevel(p);

function resolved_attach_x(p) =
    p[7] == "manual"       ? p[14] :
    p[7] == "right_center" ?  (body_half_width(p) + p[8]/2 - p[13]) :
    p[7] == "left_center"  ? -(body_half_width(p) + p[8]/2 - p[13]) : 0;

function resolved_attach_y(p) =
    p[7] == "manual"        ? p[15] :
    p[7] == "top_center"    ?  (body_half_height(p) + p[8]/2 - p[13]) :
    p[7] == "bottom_center" ? -(body_half_height(p) + p[8]/2 - p[13]) : 0;

function resolved_hole_x(p) =
    p[17] == "manual"       ? p[22] :
    p[17] == "right_center" ?  (body_half_width(p) - p[21] - p[19]/2) :
    p[17] == "left_center"  ? -(body_half_width(p) - p[21] - p[19]/2) : 0;

function resolved_hole_y(p) =
    p[17] == "manual"        ? p[23] :
    p[17] == "top_center"    ?  (body_half_height(p) - p[21] - p[19]/2) :
    p[17] == "bottom_center" ? -(body_half_height(p) - p[21] - p[19]/2) : 0;

// Calculate width and height before rotation (including attachments)
function local_max_w(p) = 
    let (bw = body_half_width(p) * 2)
    p[6] && (p[7] == "right_center" || p[7] == "left_center" || p[7] == "manual") ? bw + p[8] : bw;

function local_max_h(p) = 
    let (bh = body_half_height(p) * 2)
    p[6] && (p[7] == "top_center" || p[7] == "bottom_center" || p[7] == "manual") ? bh + p[8] : bh;

// Resolves the true bounding box after the individual tag is rotated
function rotated_bbox_w(p) = abs(degcos(p[2])) * local_max_w(p) + abs(degsin(p[2])) * local_max_h(p);
function rotated_bbox_h(p) = abs(degsin(p[2])) * local_max_w(p) + abs(degcos(p[2])) * local_max_h(p);


// ============================================================
// 2D & 3D GENERATORS
// ============================================================

module rounded_rectangle_2d(w, h, r) {
    rr = min(r, min(w, h)/2 - 0.01);
    hull() {
        translate([-w/2 + rr, -h/2 + rr]) circle(r = rr, $fn=40);
        translate([ w/2 - rr, -h/2 + rr]) circle(r = rr, $fn=40);
        translate([-w/2 + rr,  h/2 - rr]) circle(r = rr, $fn=40);
        translate([ w/2 - rr,  h/2 - rr]) circle(r = rr, $fn=40);
    }
}

module shape_2d_core(p) {
    // Tying the lookup explicitly back to the root variables prevents OpenSCAD from losing the import path during array construction
    file_val = p[34] == 1 ? t1_svg_file : p[34] == 2 ? t2_svg_file : p[34] == 3 ? t3_svg_file : p[34] == 4 ? t4_svg_file : p[34] == 5 ? t5_svg_file : p[34] == 6 ? t6_svg_file : p[34] == 7 ? t7_svg_file : p[34] == 8 ? t8_svg_file : p[34] == 9 ? t9_svg_file : t10_svg_file;
    
    if (p[1] == "oval") {
        hull() { circle(r = p[3]/2, $fn=60); translate([0, 15]) circle(r = p[4]/2, $fn=60); }
    } else if (p[1] == "square" || p[1] == "rectangle") {
        rounded_rectangle_2d(p[3], p[4], p[5]);
    } else if (p[1] == "circle" || p[1] == "hexagon") {
        circle(d = p[3], $fn=p[1]=="hexagon"?6:60);
    } else if (p[1] == "custom_svg") {
        if (file_val == "upload_your_design.svg" || file_val == "default.svg" || file_val == "") {
            // Fallback square so script doesn't crash before a file is uploaded
            rounded_rectangle_2d(p[3], p[4], p[5]);
        } else {
            resize([p[3], p[4]], auto = true) import(file = file_val, center = true);
        }
    }
}

// 2D Offset generation (Rotates the entire assembly)
module keychain_2d_silhouette(p) {
    rotate([0, 0, p[2]]) {
        union() {
            shape_2d_core(p);
            if (p[6]) {
                translate([resolved_attach_x(p), resolved_attach_y(p)])
                    circle(r = max(p[8]/2 - safe_bevel(p), 0.01), $fn=60);
            }
        }
    }
}

// 3D Body generation (Rotates the entire assembly)
module keychain_3d_body(p) {
    sb = safe_bevel(p);
    ct = core_thick(p);
    
    // Tying the lookup explicitly back to the root variables prevents OpenSCAD from losing the import path during array construction
    file_val = p[34] == 1 ? t1_svg_file : p[34] == 2 ? t2_svg_file : p[34] == 3 ? t3_svg_file : p[34] == 4 ? t4_svg_file : p[34] == 5 ? t5_svg_file : p[34] == 6 ? t6_svg_file : p[34] == 7 ? t7_svg_file : p[34] == 8 ? t8_svg_file : p[34] == 9 ? t9_svg_file : t10_svg_file;

    rotate([0, 0, p[2]]) {
        difference() {
            union() {
                // Main Body Generation 
                if (p[1] == "custom_svg" && file_val != "upload_your_design.svg" && file_val != "default.svg" && file_val != "") {
                    // Fast Layered Bevel to avoid minkowski timeout on complex SVG vectors
                    steps = 8;
                    
                    // Bottom bevel
                    for (i = [0 : steps-1]) {
                        a1 = 90 * (i / steps);
                        a2 = 90 * ((i + 1) / steps);
                        z1 = -sb * cos(a1);
                        z2 = -sb * cos(a2);
                        h_step = z2 - z1;
                        // Buffer added to prevent zero-radius math exceptions inside CGAL bounds
                        r_off = max(0.001, sb * sin(a1)); 
                        
                        translate([0, 0, z1])
                            linear_extrude(height = h_step + 0.002)
                                offset(r = r_off, $fn=30)
                                    resize([p[3], p[4]], auto = true) import(file = file_val, center = true);
                    }
                    
                    // Core
                    translate([0, 0, 0])
                        linear_extrude(height = ct + 0.002)
                            offset(r = max(0.001, sb), $fn=30)
                                resize([p[3], p[4]], auto = true) import(file = file_val, center = true);
                                
                    // Top bevel
                    for (i = [0 : steps-1]) {
                        a1 = 90 * (i / steps);
                        a2 = 90 * ((i + 1) / steps);
                        z1 = ct + sb * sin(a1);
                        z2 = ct + sb * sin(a2);
                        h_step = z2 - z1;
                        // Buffer added to prevent zero-radius math exceptions inside CGAL bounds
                        r_off = max(0.001, sb * cos(a1));
                        
                        translate([0, 0, z1])
                            linear_extrude(height = h_step + 0.002)
                                offset(r = r_off, $fn=30)
                                    resize([p[3], p[4]], auto = true) import(file = file_val, center = true);
                    }
                } else {
                    minkowski() {
                        linear_extrude(height = ct) shape_2d_core(p);
                        sphere(r = sb, $fn=30);
                    }
                }
                
                // Attachment Ring
                if (p[6]) {
                    abr = p[11]; // external bevel radius
                    inner_bevel = p[12]; // internal hole bevel radius
                    
                    // Match the target height of the main tag body unless the user specifically overrides it
                    target_total_thickness = p[10] > 0 ? p[10] : p[33];
                    
                    // Calculate the cylinder required to span the distance inside the minkowski/layered generation
                    act = max(target_total_thickness - 2*abr, 0.01);
                    z_align = abr - sb;
                    r = p[9] / 2; // hole radius
                    full_h = act + 2*abr + 2; 
                    
                    translate([resolved_attach_x(p), resolved_attach_y(p), z_align])
                    difference() {
                        minkowski() { cylinder(h = act, r = max(p[8]/2 - abr, 0.01), $fn=60); sphere(r = abr, $fn=30); }
                        
                        translate([0, 0, -abr - 1]) // Subtraction block positioned slightly below the ring
                            union() {
                                cylinder(h = full_h, r = r, $fn=40);
                                
                                // Only apply internal chamfers if enabled
                                if (inner_bevel > 0) {
                                    // Bottom chamfer
                                    translate([0, 0, 1]) 
                                        cylinder(h = inner_bevel, r1 = r + inner_bevel, r2 = r, $fn=40);
                                    // Top chamfer
                                    translate([0, 0, 1 + target_total_thickness - inner_bevel]) 
                                        cylinder(h = inner_bevel, r1 = r, r2 = r + inner_bevel, $fn=40);
                                }
                            }
                    }
                }
            }
            
            // Hanging Hole 
            if (p[16]) {
                hx = resolved_hole_x(p);
                hy = resolved_hole_y(p);
                r = p[19] / 2;
                h_len = p[20];
                full_h = p[33] + 2;
                
                translate([hx, hy, -sb - 1])
                    rotate([0, 0, p[24]])
                        union() {
                            hull() for (dx = [-h_len/2, h_len/2]) translate([dx, 0, 0]) cylinder(h = full_h, r = r, $fn=40);
                            hull() for (dx = [-h_len/2, h_len/2]) translate([dx, 0, 1]) cylinder(h = sb, r1 = r + sb, r2 = r, $fn=40);
                            hull() for (dx = [-h_len/2, h_len/2]) translate([dx, 0, sb + 1 + ct]) cylinder(h = sb, r1 = r, r2 = r + sb, $fn=40);
                        }
            }
            
            // NFC Hole (Now mapped from individual array indices)
            if (p[25]) {
                translate([p[29] ? 0 : p[30], p[29] ? 0 : p[31], p[28]])
                    cylinder(h = p[27], d = p[26], $fn=60);
            }
        }
    }
}

// ============================================================
// EXACT BATCH GRID CALCULATION & RENDERING
// ============================================================

// 1. Find the maximum cell limits based on enabled tags & rotation bounds
max_cell_w = batch_count > 0 ? max([for (p = production_batch) rotated_bbox_w(p)]) + cutout_tolerance * 2 : 0;
max_cell_h = batch_count > 0 ? max([for (p = production_batch) rotated_bbox_h(p)]) + cutout_tolerance * 2 : 0;

step_x = max_cell_w + grid_spacing;
step_y = jig_interlocking ? (max_cell_h + grid_spacing) * jig_row_compression : (max_cell_h + grid_spacing);

// 2. Determine max columns allowed by the physical printer plate
limit_plate_w = (plate_size == "small") ? 333 : 335;
max_cols_allowed = floor((limit_plate_w - grid_spacing) / step_x);

// 3. Size the array width based on batch count, up to the printer limit
actual_cols = batch_count > 0 ? min(batch_count, max_cols_allowed) : 1;

// 4. Calculate exact rows required for this specific batch count
function calc_rows(remaining, cols, interlock, current_row=0) =
    remaining <= 0 ? current_row :
    let(row_capacity = (interlock && current_row % 2 != 0) ? cols - 1 : cols)
    calc_rows(remaining - row_capacity, cols, interlock, current_row + 1);

actual_rows = batch_count > 0 ? calc_rows(batch_count, actual_cols, jig_interlocking) : 1;

// 5. Build dynamic plate sizing strictly around the packed layout
plate_w = (actual_cols * step_x) + grid_spacing;
plate_h = (actual_rows * step_y) + grid_spacing + (jig_interlocking ? (max_cell_h * 0.134) : 0);

start_x = -(actual_cols * step_x)/2 + step_x/2;
start_y = (actual_rows * step_y)/2 - step_y/2;

// Helper to linearly map a loop iteration (r, c) to the correct array index
function get_idx(r, c, cols, interlock) =
    let(
        full_pairs = floor(r / 2),
        pair_cap = interlock ? (2 * cols - 1) : (2 * cols),
        even_row_offset = (r % 2 != 0) ? cols : 0
    )
    (full_pairs * pair_cap) + even_row_offset + c;

// ============================================================
// DYNAMIC JIG EXTRUSION LOGIC
// ============================================================

function get_max_tag_thickness() = batch_count > 0 ? max([for (p = production_batch) p[33]]) : 4.0;
function get_total_jig_h() = jig_base_thickness + max(0.5, get_max_tag_thickness() - tag_protrusion);

// A tag may be thinner than the requested protrusion, so we clamp the pocket depth to prevent negative Z errors
function get_pocket_depth(p) = max(0, p[33] - tag_protrusion);


module render_tags(preview = false) {
    if (batch_count > 0) {
        total_jig_h = get_total_jig_h();
        
        for (r = [0 : actual_rows - 1]) {
            is_staggered = jig_interlocking && (r % 2 != 0);
            row_cols = is_staggered ? actual_cols - 1 : actual_cols;
            x_shift = is_staggered ? (step_x / 2) : 0;
            
            for (c = [0 : row_cols - 1]) {
                idx = get_idx(r, c, actual_cols, jig_interlocking);
                if (idx < batch_count) {
                    p = production_batch[idx];
                    
                    // If previewing, shift the Z-height up so they sit flush in their variable-depth jig pockets.
                    // If exporting for print, shift them up by exactly `safe_bevel` so their lowest point rests flat on Z=0.
                    z_pos = preview ? ((total_jig_h - get_pocket_depth(p)) + safe_bevel(p)) : safe_bevel(p);
                    
                    translate([start_x + (c * step_x) + x_shift, start_y - (r * step_y), z_pos])
                        keychain_3d_body(p);
                }
            }
        }
    } else {
        echo("WARNING: No tags enabled.");
    }
}

module render_jig() {
    if (batch_count > 0) {
        total_jig_h = get_total_jig_h();
        
        difference() {
            translate([0, 0, total_jig_h/2]) cube([plate_w, plate_h, total_jig_h], center=true);
            
            for (r = [0 : actual_rows - 1]) {
                is_staggered = jig_interlocking && (r % 2 != 0);
                row_cols = is_staggered ? actual_cols - 1 : actual_cols;
                x_shift = is_staggered ? (step_x / 2) : 0;
                
                for (c = [0 : row_cols - 1]) {
                    idx = get_idx(r, c, actual_cols, jig_interlocking);
                    if (idx < batch_count) {
                        p = production_batch[idx];
                        pocket_depth = get_pocket_depth(p);
                        pocket_floor_z = total_jig_h - pocket_depth;
                        
                        // Item cutout starting perfectly at the floor of the pocket, cutting up through the top.
                        translate([start_x + (c * step_x) + x_shift, start_y - (r * step_y), pocket_floor_z])
                            linear_extrude(height = pocket_depth + 10)
                                offset(r = safe_bevel(p) + cutout_tolerance, $fn=30)
                                    keychain_2d_silhouette(p);
                    }
                }
            }
            
            // Extraction Grooves (Cuts relative to the top of the jig down to the specified depth)
            if (thumb_grooves) {
                for (r = [0 : actual_rows - 1]) {
                    translate([0, start_y - (r * step_y), total_jig_h - thumb_groove_depth])
                        cube([plate_w - 8, thumb_groove_width, thumb_groove_depth * 2 + 10], center=true);
                }
            }
        }
    }
}

// ============================================================
// EXECUTION
// ============================================================

if (output_type == "tags") {
    render_tags(preview = false);
} else if (output_type == "jig") {
    render_jig();
} else if (output_type == "combined") {
    color("gray", 0.5) render_jig();
    color("orange") render_tags(preview = true);
}
